[Unit]
Description=AI Gateway - ONNX Embedding Service (bge-small-zh)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-gateway
ExecStart=/tmp/onnx-venv/bin/python /home/ubuntu/ai-gateway/scripts/embed_server.py
Restart=on-failure
RestartSec=5
MemoryMax=200M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
