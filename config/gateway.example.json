{
  "server": {
    "port": 9000,
    "max_body_bytes": 20971520,
    "max_connections": 256,
    "idle_timeout_seconds": 30
  },
  "backend": {
    "url": "https://api.deepseek.com/v1/chat/completions",
    "api_key_env": "LLM_API_KEY",
    "model": "deepseek-v4-flash",
    "timeout_seconds": 60
  },
  "embedding": {
    "model_path": "model/model_int8.onnx",
    "vocab_path": "model/vocab.txt",
    "dim": 512,
    "_note": "本地 ONNX 推理；路径相对进程工作目录（systemd 单元设置了 WorkingDirectory）。dim 必须与模型实际输出一致，否则启动即失败"
  },
  "cache": {
    "enabled": true,
    "similarity_threshold": 0.85,
    "max_entries": 10000,
    "ttl_days": 7
  },
  "filter": {
    "max_input_chars": 500,
    "max_output_chars": 0,
    "block_urls": true,
    "blocked_keywords": []
  },
  "log": {
    "sample_every": 1,
    "max_bytes": 10485760,
    "keep_files": 5,
    "_note": "max_bytes=0 关闭轮转（单文件一直追加）；否则 gateway.log 满 max_bytes 后改名为 gateway.log.1，旧的依次后移，最老一份删除，共保留 keep_files 份历史"
  },
  "cost": {
    "input_per_1k": 0.001,
    "output_per_1k": 0.004,
    "_note": "费用估算单价（元/1K tokens）。DeepSeek v4-flash 实际是输入 ¥1/M、输出 ¥4/M。不写 cost 段时按旧的统一单价 0.001/0.001 估算（向后兼容）"
  }
}
